<mujoco model="tonypi_scene">
  <include file="robot.xml"/>

    <!-- <option gravity="0 0 0"/> -->

  <statistic center="0 0 0.2" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <!-- offwidth/offheight size the OFFSCREEN framebuffer, and MuJoCo's
         default is only 640x480: mujoco.Renderer raises outright above it.
         Every figure and video this project produces is rendered offscreen, so
         this is a model-level capability, not a framing preset (framing lives
         in walk/common/render.py as mjvCamera presets, deliberately kept out
         of the XML because robot.xml/scene.xml are under a byte-identical
         regeneration test). 1920x1440 keeps the 4:3 aspect of the default and
         leaves room for 2x supersampling of a 960x720 frame. -->
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1440"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7"
             rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- priority=2 so ground contact is structurally immune to any tuning of
         the self-collision guards: a higher-priority geom supplies condim,
         friction, solref and solimp wholesale, instead of solref being
         combined as a solmix-weighted average. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          condim="3" friction="0.9 0.005 0.0001" priority="2"/>
  </worldbody>
</mujoco>
