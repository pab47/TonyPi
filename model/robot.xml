  <contact>
    <!-- Parent-child pairs share a joint, so their primitives always
         overlap there. Excluded automatically from the tree. Everything
         else DOES collide, which is the point: limbs previously passed
         through each other and through the torso. -->
    <exclude body1="torso" body2="head_pan"/>
    <exclude body1="head_pan" body2="head_tilt"/>
    <exclude body1="r_knee" body2="r_ankle_pitch"/>
    <exclude body1="r_ankle_pitch" body2="r_ankle_roll"/>
    <exclude body1="r_shoulder_roll" body2="r_elbow"/>
    <exclude body1="r_elbow" body2="r_gripper"/>
    <exclude body1="r_hip_roll" body2="r_hip_pitch"/>
    <exclude body1="torso" body2="r_hip_roll"/>
    <exclude body1="r_hip_pitch" body2="r_knee"/>
    <exclude body1="torso" body2="r_shoulder_pitch"/>
    <exclude body1="r_shoulder_pitch" body2="r_shoulder_roll"/>
    <exclude body1="l_knee" body2="l_ankle_pitch"/>
    <exclude body1="l_ankle_pitch" body2="l_ankle_roll"/>
    <exclude body1="l_shoulder_roll" body2="l_elbow"/>
    <exclude body1="l_elbow" body2="l_gripper"/>
    <exclude body1="l_hip_roll" body2="l_hip_pitch"/>
    <exclude body1="torso" body2="l_hip_roll"/>
    <exclude body1="l_hip_pitch" body2="l_knee"/>
    <exclude body1="torso" body2="l_shoulder_pitch"/>
    <exclude body1="l_shoulder_pitch" body2="l_shoulder_roll"/>
    <exclude body1="head_pan" body2="r_shoulder_pitch"/>  <!-- neck base and shoulder bracket are both fixed torso structure; their coarse boxes overlap 0.8 mm at home and they cannot collide in reality -->
    <exclude body1="head_pan" body2="l_shoulder_pitch"/>  <!-- mirror of the above -->

    <!-- Foot-vs-foot. Was an <exclude>, which let a policy scissor its
         feet through each other for free, so it is now a real <pair>.

         margin AND gap ARE ZERO ON PURPOSE. The plan called for
         margin=gap=8 mm, believing includemargin = margin - gap = 0
         would DETECT contacts from 8 mm out while carrying no force
         until real interpenetration. Measured in mujoco 3.10 that is
         not what happens: `gap` has NO effect on a <pair>,
         includemargin tracks margin alone, and force scales with it.
         At the shipped solref below, home keyframe, t=0, margin=8 mm
         shoves the feet apart with 3.95 N while they are 7.4 mm
         APART, and margin=20 mm with 12.60 N; margin=0 gives exactly
         0 N. A margin here is pure VIRTUAL PENETRATION -- the same
         failure the contact-margin note above records. Full table,
         conditions, and the stiffer-solref figures behind the
         original decision are in tools/gen_mjcf.py.

         Proximity for reward shaping does NOT need a margin: use
         mj_geomDistance (walk/common/selfdist.py), a pure geometry
         query that cannot perturb the physics.

         solref timeconst 0.04 s, NOT the 0.01 the plan assumed --
         measured foot clearance is only 3.6-5.8 mm, so a stiffer
         pair turns every swing brush into a gait-destroying impulse
         (0.01 -> -73.2 mm travelled, 0.04 -> -143.1 mm, baseline
         -139.9 mm). condim=1 avoids injecting tangential force
         between the feet. -->
    <pair geom1="r_ankle_roll_sole" geom2="l_ankle_roll_sole" condim="1" solref="0.04 1" margin="0.0" gap="0.0"/>
  </contact>

