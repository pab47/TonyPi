<mujoco model="tonypi_pro">
  <!-- GENERATED by tools/gen_mjcf.py from joints.json,
       link_inventory.json and inertia.json. Do not hand-edit. -->
  <compiler angle="radian" autolimits="true"
            balanceinertia="false"/>
  <option timestep="0.004" integrator="implicitfast" cone="elliptic"
          impratio="10"/>

  <default>
    <default class="body_servo">
      <!-- armature = reflected rotor inertia N^2*I_rotor. Hiwonder does
           not publish the LX-824HV gear ratio, so 0.015 is an ESTIMATE
           from a ~250-300:1 reduction. NOTE: raising armature LOWERS
           the damping ratio (zeta = c/(2*sqrt(kp*I))) -- it is not a
           cure for jitter; dampratio is. -->
      <!-- damping = TORQUE-SPEED CURVE, not a tuning knob. forcerange
           is a FLAT cap, so without this the actuator delivers full
           stall torque at any speed and the joint can outrun the real
           servo. A DC motor gives tau(w) = tau_stall*(1 - w/w_noload);
           subtracting viscous cw with c = tau_stall/w_noload =
           1.667/5.236 = 0.3184 N.m.s/rad reproduces that line.
           Measured over the 116-action corpus at the previous 0.1:
           arm joints peaked at 13.34 rad/s = 2.55x the servo no-load
           speed, with the 99th percentile still over the cap. -->
      <joint damping="0.3184" frictionloss="0.02" armature="0.015"/>
      <!-- dampratio 0.60, NOT 0.85. MuJoCo derives kv from kp and link
           inertia only; it never reads the joint damping above, so the
           two add. Measured zeta over the 18 bus joints: 0.95-0.97 at
           the old damping 0.1/dampratio 0.85, 1.15-1.23 if 0.85 is kept
           alongside damping 0.3184, and 0.90-0.98 at 0.60. 0.60 keeps
           zeta where every earlier gate result was measured. -->
      <position kp="12" dampratio="0.6" forcerange="-1.667 1.667"/>
    </default>
    <default class="head_servo">
      <!-- Same torque-speed derivation as the bus servos. LFD-01M is
           0.10 s/60 deg at 6 V = 10.472 rad/s no-load, stall 1.8 kgf.cm
           = 0.1765 N.m, so c = 0.0168. The head servos are about
           TWICE as fast as the bus servos. The previous hand-picked
           0.05 implied 297 ms/60 deg, 3x too slow. -->
      <joint damping="0.0168" frictionloss="0.01" armature="0.005"/>
      <position kp="4" dampratio="0.85" forcerange="-0.176 0.176"/>
    </default>
    <default class="selfcol">
      <!-- Interpenetration guards only. condim=1 (frictionless): they
           are coarse approximations, and giving them Coulomb friction
           injected spurious tangential force into the arms and thence
           the base. friction is zeroed explicitly because MuJoCo takes
           the ELEMENTWISE MAX across a pair, and the default geom
           friction of 1.0 would otherwise RAISE ground friction above
           the floor's 0.9 for any guard-vs-floor contact. -->
      <geom group="3" condim="1" friction="0 0 0" mass="0" rgba="0.3 0.6 0.9 0.35"/>
    </default>
    <default class="collision">
      <!-- priority=2: a higher-priority geom wins WHOLESALE - condim,
           friction, solref and solimp all come from it. Without it,
           solref is combined as a solmix-weighted AVERAGE, so any
           tuning of the guards would silently soften ground contact
           too (measured: floor peak force 142.5 -> 86.5 N). With it,
           ground contact is structurally independent of the guards. -->
      <!-- No margin. MuJoCo computes efc_pos = dist - includemargin, so
           a contact margin acts as VIRTUAL PENETRATION: a 1 mm margin
           held the robot 0.69 mm ABOVE the floor at equilibrium, zeroed
           both foot touch sensors, and drove the measured gait duty
           factor to 0.000 with a 100% flight phase. Contact detection
           at exactly dist==0 is instead handled by starting the
           keyframe at a small real penetration -- see PRELOAD_M. -->
      <geom group="3" condim="3" friction="0.9 0.005 0.0001" priority="2" rgba="0.8 0.3 0.3 0.6"/>
    </default>
    <default class="visual">
      <!-- STEP-derived hull meshes (tools/gen_meshes.py). VISUAL
           ONLY: density=0 and no contact, so the physics is
           bit-identical whether or not assets/ is populated. They
           exist for Phase 5.5, where reading a stack of translucent
           boxes by eye is the slow way to find a modelling bug. -->
      <geom contype="0" conaffinity="0" group="2" density="0" rgba="0.72 0.75 0.78 1"/>
    </default>
    <default class="internal">
      <geom type="box" contype="0" conaffinity="0" group="4" rgba="0.5 0.6 0.7 0.45"/>
    </default>
  </default>

